<?xml version="1.0" encoding="utf-8"?>
<!--
  Web.config.example: the settings you must supply locally.

  Oasis_Web/Web.config is tracked in git with PLACEHOLDER values. Copy the
  values below into your local Web.config and fill them in. Do not commit real
  credentials: the file is tracked, so a real password would be published.

  Only the two sections below need editing. Everything else in Web.config
  (auth mode, handlers, binding redirects) must stay identical across machines.
-->
<configuration>

  <appSettings>
    <!-- Host of the Oasis REST API that the WinForms client and the portal
         call. No scheme and no trailing slash, since ApiOasis prefixes "https://".
         Production: api.synovora.com
         Local IIS Express: localhost:44355 -->
    <add key="ServeurOasis" value="api.synovora.com" />

    <!-- Symmetric key used to encrypt the connection string handed to desktop
         clients by /api/login, and by EncryptString/DecryptString generally.

         This value was hardcoded in Oasis_Common/Module/ModuleUtilsBase.vb until
         2026-08-23. That old value is public and must never be reused.

         The server and EVERY deployed client must carry the SAME value, so
         changing it requires a coordinated rollout. See the README section
         "Cryptographic key". Generate at least 32 random characters, for example:
           openssl rand -base64 32 -->
    <add key="OasisCryptoKey" value="CHANGE_ME_32_RANDOM_CHARS_MINIMUM" />

    <!-- Leave false. true disables TLS certificate validation for calls to the
         Oasis API, and those calls carry database credentials. Only ever set it
         true against a local test server with a self-signed certificate. -->
    <add key="AllowInvalidServerCertificate" value="false" />

    <!-- Absolute path on the web server where documents posted through
         /api/docfileupload are written, and read back by /api/docfiledownload.
         Must exist and be writable by the IIS app pool identity.
         Sub-episode documents land in a "SousEpisode" subfolder. -->
    <add key="FileUploadLocation" value="c:\db\oasis\upload" />
    <!-- Domaines vers lesquels /api/sendMail accepte d'écrire, séparés par des
         points-virgules. Les adresses déjà connues de la base (patient du
         dossier, annuaire professionnel) passent quel que soit leur domaine.
         Vide, seules ces adresses connues sont acceptées. -->
    <add key="MailDomainesAutorises" value="" />
    <!-- Mode de sécurité de la liaison SMTP : SslOnConnect (défaut), StartTls,
         StartTlsWhenAvailable, Auto, None. SslOnConnect ouvre la connexion en TLS
         sans négociation en clair. Ne passer à Auto ou StartTls que si le
         fournisseur n'écoute qu'en 587, et de préférence après la montée de
         MailKit en 4.x : la version 2.13 est concernée par une injection de
         réponse pendant STARTTLS. -->
    <add key="MailSecuriteSmtp" value="SslOnConnect" />
  </appSettings>

  <connectionStrings>
    <!-- Two SQL logins, and the difference matters.

         oasis_web is the server's own. It stays on this machine. It is the only
         account allowed to read password hashes, prescriber signing keys, portal
         credentials and the SMTP password.

         oasis_client is what /api/login hands to every desktop client that
         authenticates, AES-encrypted with OasisCryptoKey. Since that key also
         ships to every workstation, assume anything oasis_client can read is
         readable by any user. The column-level denials in
         docs/migrations/2026-08-24-comptes-sql-separes.sql are what keep that
         acceptable. Never put the server's account in this second entry.

         See "How authentication works" in the README.

         encrypt=true;trustServerCertificate=false : the link to SQL Server must
         be authenticated, not merely encrypted. SQL Server needs a certificate
         the machine trusts. Setting trustServerCertificate=true is a development
         convenience only: this string reaches every workstation, so anyone able
         to answer on port 1433 would collect the credentials. -->
    <add name="Oasis_WF.My.MySettings.oasisConnection"
         connectionString="Data Source=SQLSERVER_HOST;Initial Catalog=oasis;persist security info=True;user id=oasis_web;password=DB_PASSWORD_WEB;encrypt=true;trustServerCertificate=false;MultipleActiveResultSets=True"
         providerName="System.Data.SqlClient" />
    <add name="Oasis_WF.My.MySettings.oasisConnectionClient"
         connectionString="Data Source=SQLSERVER_HOST;Initial Catalog=oasis;persist security info=True;user id=oasis_client;password=DB_PASSWORD_CLIENT;encrypt=true;trustServerCertificate=false;MultipleActiveResultSets=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

</configuration>
